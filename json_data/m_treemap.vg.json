
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Proportion of Protected Marine Areas by IUCN Category"
  },
  "data": {
    "url": "MCAPAD_2024.json"
  },
  "width": 400,
  "height": 400,
  "mark": {
    "type": "arc",
    "innerRadius": 70,
    "outerRadius": 160,
    "stroke": "white"
  },
  "encoding": {
    "theta": {
      "field": "Percentage of protected area per category",
      "type": "quantitative",
      "stack": true
    },
    "color": {
      "field": "IUCN FULL",
      "type": "nominal",
      "title": "IUCN Category"
    },
    "tooltip": [
      {
        "field": "IUCN FULL",
        "type": "nominal",
        "title": "IUCN Category"
      },
      {
        "field": "Percentage of protected area per category",
        "type": "quantitative",
        "title": "Percentage of protected area (%)",
        "format": ".2f"
      }
    ]
  }
}
