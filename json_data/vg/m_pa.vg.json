
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "title": {
        "text": ""
    },

    "data": {
        "url": "json_data/m_pa.json"
    },

    "width": 600,
    "height": 500,

    "transform": [
        {
            "window": [
                {
                    "op": "rank",
                    "as": "Rank"
                }
            ],
            "sort": [
                {
                    "field": "Percentage of coverage",
                    "order": "descending"
                }
            ],
            "groupby": ["Year"]
        }
    ],

    "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
            "filled": true,
            "size": 70
        }
    },

    "encoding": {
        "x": {
            "field": "Year",
            "type": "ordinal",
            "title": "Year",
            "axis": {
                "labelAngle": 0,
                "domain": true,
                "domainColor": "#666666",
                "domainWidth": 1
            }
        },

        "y": {
            "field": "Rank",
            "type": "ordinal",
            "scale": {
                "zero": false
            },
            "axis": {
                "title": "Rank",
                "tickMinStep": 1
            }
        },

        "color": {
            "field": "State Full Name",
            "type": "nominal",
            "scale": {
                "domain": [
                    "Australian Capital Territory",
                    "External Territories",
                    "Commonwealth",
                    "New South Wales",
                    "Northern Territory",
                    "Queensland",
                    "South Australia",
                    "Tasmania",
                    "Victoria",
                    "Western Australia"
                ],
                "range": [
                    "#27d62f",
                    "#ff9da6",
                    "#54a24b",
                    "#4c78a8",
                    "#f58518",
                    "#6b705c",
                    "#b279a2",
                    "#eecb3b",
                    "#663518",
                    "#72b7b2"
                ]
            },
            "legend":null
        },

        "detail": {
            "field": "State Full Name"
        },

        "order": {
            "field": "Year",
            "type": "ordinal"
        },

        "tooltip": [
            {
                "field": "State Full Name",
                "type": "nominal",
                "title": "State"
            },
            {
                "field": "Year",
                "type": "ordinal",
                "title": "Year"
            },
            {
                "field": "Percentage of coverage",
                "type": "quantitative",
                "title": "Coverage (%)",
                "format": ".3f"
            },
            {
                "field": "Rank",
                "type": "ordinal",
                "title": "Rank"
            }
        ]
    }
}
