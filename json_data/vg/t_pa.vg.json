{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "title": { "text": "Terrestrial Protected Areas Coverage" },

    "data": {
        "url": "json_data/t_pa.json"
    },
    "width": 600,
    "height": 800,
    "mark": {
        "type": "line",
        "strokeWidth": 3
    },
    "encoding": {
        "x": {
            "field": "Year",
            "type": "ordinal",
            "title":"Year"
        },
        "y": {
            "field": "Percentage of Protected Area/Assigned area",
            "type": "quantitative",
            "scale": {
                "zero": true,
                "nice": true
            },
            "axis": {
                "title": "Coverage of Protected Areas",
                "format": ".2f",
                "tickCount": 10
            }
        },
        "color": {
            "field": "State Full Name",
            "type": "nominal",
            "scale": {
                "domain": [
                    "Australian Capital Territory",
                    "External Territories",
                    "New South Wales",
                    "Northern Territory",
                    "Queensland",
                    "South Australia",
                    "Tasmania",
                    "Victoria",
                    "Western Australia"
                ],
                "range": [
                    "#e45756",
                    "#ff9da6",
                    "#4c78a8",
                    "#f58518",
                    "#72b7b2",
                    "#b279a2",
                    "#eecb3b",
                    "#663518",
                    "#6b705c"
                ]
            },
            "legend": {
                "title": "Jurisdiction",
                "orient": "right"
            }
        },
        "detail": {"field": "State Full Name"},
        "order": {
            "field": "Year",
            "type": "quantitative"
        },
        "tooltip": [
            {"field": "State Full Name", "type": "nominal", "title": "State"},
            {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
            {
                "field": "Percentage of Protected Area/Assigned area",
                "type": "quantitative",
                "title": "Percentage of coverage",
                "format": ".3f"
            }
        ]
    }
}