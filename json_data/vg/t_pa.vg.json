{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "title": { "text": "Terrestrial Protected Areas Coverage Rankings" },

    "data": {
        "url": "json_data/t_pa.json"
    },
    "width": 600,
    "height": 500,

"transform": [
    {
        "window": [
            {
                "op": "row_number",
                "as": "Rank"
            }
        ],
        "sort": [
            {
                "field": "Percentage of Protected Area/Assigned area",
                "order": "descending"
            },
            {
                "field": "State Full Name",
                "order": "ascending"
            }
        ],
        "groupby": ["Year"]
    }
],

    "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
            "filled": true,
            "size": 70
        }
    },
    "encoding": {
        "x": {
            "field": "Year",
            "type": "ordinal",
            "title":"Year",
            "axis": {
                "labelAngle": 0
            }
        },
        "y": {
            "field": "Rank",
            "type": "ordinal",
            "scale": {
                "zero": false
            },
            "axis": {
                "title": "Rank",
                "tickMinStep": 1
            }
        },

        "color": {
            "field": "State Full Name",
            "type": "nominal",
            "scale": {
                "domain": [
                    "Australian Capital Territory",
                    "External Territories",
                    "New South Wales",
                    "Northern Territory",
                    "Queensland",
                    "South Australia",
                    "Tasmania",
                    "Victoria",
                    "Western Australia"
                ],
                "range": [
                    "#e45756",
                    "#ff9da6",
                    "#4c78a8",
                    "#f58518",
                    "#6b705c",
                    "#b279a2",
                    "#eecb3b",
                    "#663518",
                    "#72b7b2"

                ]
            },
            "legend": null
        },
        "detail": {"field": "State Full Name"},
        "order": {
            "field": "Year",
            "type": "ordinal"
        },
        "tooltip": [
            {"field": "State Full Name", "type": "nominal", "title": "State"},
            {"field": "Year", "type": "ordinal", "title": "Year", "format": "d"},
            {
                "field": "Percentage of Protected Area/Assigned area",
                "type": "quantitative",
                "title": "Percentage of coverage",
                "format": ".3f"
            },
            {
                "field": "Rank",
                "type": "ordinal",
                "title": "Rank"
            }
        ]
    }
}