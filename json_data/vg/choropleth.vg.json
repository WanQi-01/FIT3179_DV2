
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "title": {
        "text": "Terrestrial Protected Areas by GIS Area"
    },

    "width": 700,
    "height": 600,

    "data": {
        "url": "data/spatial_data/terrestrial.topojson",
        "format": {
            "type": "topojson",
            "feature": "Collaborative_Australian_Protected_Areas_Database_(CAPAD)_2024_-_Terrestrial__"
        }
    },

    "transform": [
        {
            "calculate": "toNumber(datum.properties.GIS_AREA)",
            "as": "GIS_AREA"
        },
        {
            "calculate": "datum.properties.PA_PID",
            "as": "PA_PID"
        },
        {
            "calculate": "datum.properties.NAME",
            "as": "NAME"
        },
        {
            "calculate": "datum.properties.STATE",
            "as": "STATE"
        },
        {
            "calculate": "datum.properties.IUCN",
            "as": "IUCN"
        }
    ],
    "projection": {
        "type": "mercator",
        "center": [134, -27],
        "scale": 500
    },

    "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.25
    },

    "encoding": {
        "color": {
            "field": "GIS_AREA",
            "type": "quantitative",
            "scale": {
                "scheme": "blues"
            },
            "legend": {
                "title": "GIS Area"
            }
        },

        "tooltip": [
            {
                "field": "PA_PID",
                "type": "nominal",
                "title": "Protected Area ID"
            },
            {
                "field": "NAME",
                "type": "nominal",
                "title": "Protected Area"
            },
            {
                "field": "STATE",
                "type": "nominal",
                "title": "State"
            },
            {
                "field": "GIS_AREA",
                "type": "quantitative",
                "title": "GIS Area",
                "format": ",.3f"
            },
            {
                "field": "IUCN",
                "type": "nominal",
                "title": "IUCN Category"
            }
        ]
    }
}
