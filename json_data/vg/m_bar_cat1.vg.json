
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "",
  "data": {
    "url": "json_data/reserve_cat_m.json"
  },
  "width": 300,
  "height": 140,
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "GIS_AREA",
          "as": "Total GIS Area"
        }
      ],
      "groupby": ["Category"]
    },
    {
      "calculate": "datum['Total GIS Area'] / 768809493.8 * 100",
      "as": "Percentage"
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "y": {
      "field": "Category",
      "type": "nominal",
      "sort": "-x",
      "title": "Conservation Types"
    },
    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage of Total Protected Area (%)"
    },
    "color": {"value": "purple"},
    "tooltip": [
      {
        "field": "Category",
        "type": "nominal"
      },
      {
        "field": "Total GIS Area",
        "type": "quantitative",
        "format": ",.2f"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "format": ".2f"
      }
    ]
  }
}
