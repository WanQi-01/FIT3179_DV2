
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "",
    "fontSize": 15,
    "subtitle": "Change in protected marine area (ha)"
  },
  "width": 500,
  "height": 450,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/spatial_data/AUS_STATE_SHAPE.topojson",
    "format": {
      "type": "topojson",
      "feature": "STE_2026_AUST_GDA2020"
    }
  },
    "params": [
    {
      "name": "stateSelection",
      "select": {
        "type": "point",
        "fields": ["Matched State Name"],
        "on": "click",
        "clear": "dblclick"
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.properties.STE_NAME26 === 'Outside Australia' ? 'Commonwealth' : datum.properties.STE_NAME26",
      "as": "Matched State Name"
    },
    {
      "lookup": "Matched State Name",
      "from": {
        "data": {
          "url": "json_data/final_state_growth_m.json"
        },
        "key": "State Full Name",
        "fields": [
          "Growth Between 2016 to 2024",
          "Percentage of Growth Between 2016 to 2024",
          "Protected Area (ha)",
          "Total Sea Area",
          "Percentage of coverage"
        ]
      }
    },
    {
      "calculate": "isValid(datum['Growth Between 2016 to 2024']) ? (datum['Growth Between 2016 to 2024'] < 0 ? 'Decline' : datum['Growth Between 2016 to 2024'] > 0 ? 'Growth' : 'No change') : 'No data'",
      "as": "Growth Direction"
    },
    {
      "calculate": "abs(datum['Growth Between 2016 to 2024'])",
      "as": "Absolute Growth"
    },
    {
      "calculate": "!isValid(datum['Growth Between 2016 to 2024']) ? 'No data' : datum['Absolute Growth'] <= 40378 ? 'Very low' : datum['Absolute Growth'] <= 2355375 ? 'Low to moderate' : datum['Absolute Growth'] <= 2786198 ? 'High' : 'Very high'",
      "as": "Growth Magnitude"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 0.8
  },
    "encoding": {
    "color": {
      "condition": {
        "param": "stateSelection",
        "field": "Percentage of Growth Between 2016 to 2024",
        "type": "quantitative",
        "scale": {
          "domain": [-0.05, 0, 0.3],
          "range": ["#ca462f", "#f7f7f7", "#5f469a"],
          "clamp": true
        },
        "legend": {
          "title": "Growth in Protected Area(%)",
          "format": ".0%",
          "orient": "bottom",
          "direction": "horizontal",
          "values":  [-0.05, 0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3]
        }
      },
      "value": "#d3d3d3"
    },

    "tooltip": [
      {
        "field": "Matched State Name",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Growth Between 2016 to 2024",
        "type": "quantitative",
        "title": "Net growth (ha)",
        "format": ",.0f"
      },
      {
        "field": "Percentage of Growth Between 2016 to 2024",
        "type": "quantitative",
        "title": "Percentage growth",
        "format": ".4%"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
