
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Protected Area by Category",
    "subtitle": "Each square represents 1% of 894,071,061.4 ha"
  },
  "data": {
    "name": "waffleData"
  },
  "width": 300,
  "height": 300,
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null,
      "scale": {
        "paddingInner": 0.08,
        "paddingOuter": 0.02
      }
    },
    "y": {
      "field": "y",
      "type": "ordinal",
      "sort": "descending",
      "axis": null,
      "scale": {
        "paddingInner": 0.08,
        "paddingOuter": 0.02
      }
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "range": [
          "#65889e", "#284952", "#d3d3d3"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "Category",
        "type": "nominal"
      },
      {
        "field": "Category Area (ha)",
        "type": "quantitative",
        "format": ",.2f"
      },
      {
        "field": "Percentage (%)",
        "type": "quantitative",
        "format": ".2f"
      }
    ]
  }
}
